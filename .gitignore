# See https://git-scm.com/docs/gitignore for details.

# Node.js dependencies and generated web output
/node_modules/
/.pnp
/.pnp.js
/.next/
/out/
/coverage/

# Local visual-test scratch output
/.tmp-gs/
/.tmp-gallery/

# Local Gradle cache
/.gradle/

# Android machine-specific SDK path, build output, and packaged artifacts
/android/local.properties
/android/.gradle/
/android/build/
/android/app/build/
/android/capacitor-cordova-android-plugins/build/
/android/app/src/main/assets/public/
/android/app/src/main/assets/capacitor.config.json
*.apk
*.aab

# iOS generated Xcode state and synced web assets
/ios/App/Pods/
/ios/App/build/
/ios/App/DerivedData/
/ios/App/App/public/
/ios/App/App/capacitor.config.json
**/xcuserdata/
*.xcuserstate

# Environment files: commit templates with placeholder values only
.env
.env.*
!.env.example
!.env.*.example

# Credential and private-key material
.secret
.secrets
*.secret
*.secrets
*.credentials
*.credentials.json
*.key
*.pem
*.p12
*.pfx
*.p8
*.jks
*.keystore
key.properties
keystore.properties

# Common credential filenames (wherever they occur)
secret.json
secrets.json
credentials.json

# Common root-level local credential stores
/secret/
/secrets/
/credentials/

# iOS signing profiles
*.mobileprovision
*.provisionprofile

# OS metadata
.DS_Store
Thumbs.db
Desktop.ini

# Package-manager debug logs and TypeScript build cache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
tsconfig.tsbuildinfo

# Local downloaded image-processing packages and model weights
/tmp/rembg/
/tmp/u2net/

# Local conversation exports (Codex chat history is stored outside this repo)
/chat-history/
/conversation-history/
/conversations/

# Image-generation sidecar metadata is not used at runtime
/public/icons/*.webp.json
/public/pets/*.webp.json

# Vercel local project state
/.vercel/
